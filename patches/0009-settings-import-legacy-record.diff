     CHECK(b.relay_known==15&&b.relay_on==2&&b.energy_valid==1&&b.energy_wh[0]==1234&&b.energy_raw[1]==99);
 }
 
+/* 2.1.0 starts a fresh journal; the fork imports the newer 2.0.x record once.
+ * These checks pin the decode half: choose the newer slot, extract, unpack. */
+static void test_legacy_record_import(void){
+    uint8_t slot[2][MTTL_SETTINGS_SLOT],body[MTTL_SETTINGS_BODY_MAX],extract[1216];
+    mttl_settings older,newer,out;size_t n,m;uint32_t seq;
+    mttl_settings_default(&older);mttl_settings_default(&newer);
+    strcpy(newer.device,"MTTL-LivingRoom");newer.language=2;newer.button_lock=5;
+    newer.protection.current_ma=16000;newer.timer_minutes[3]=45;
+    older.language=1;older.button_lock=0;older.timer_minutes[2]=0;
+    n=mttl_settings_storage_pack(&older,body,sizeof(body));
+    CHECK(n&&mttl_settings_encode(slot[1],body,n,41));
+    slot[1][MTTL_SETTINGS_SLOT-1]=0; /* the storage driver programs the commit byte */
+    n=mttl_settings_storage_pack(&newer,body,sizeof(body));
+    CHECK(n&&mttl_settings_encode(slot[0],body,n,42));
+    slot[0][MTTL_SETTINGS_SLOT-1]=0;
+    CHECK(mttl_settings_choose(slot[0],slot[1])==0);
+    CHECK(mttl_settings_choose(slot[1],slot[0])==1);
+    /* Without its commit byte a legacy slot is not a candidate. */
+    slot[0][MTTL_SETTINGS_SLOT-1]=1;
+    CHECK(!mttl_settings_validate(slot[0],&seq,&m));
+    slot[0][MTTL_SETTINGS_SLOT-1]=0;
+    CHECK(mttl_settings_extract(slot[0],extract,sizeof(extract),&m));
+    CHECK(mttl_settings_storage_unpack(extract,m,&out));
+    CHECK(!strcmp(out.device,"MTTL-LivingRoom"));
+    CHECK(out.language==2&&out.button_lock==5&&out.timer_minutes[3]==45);
+    CHECK(out.protection.current_ma==16000);
+    /* Two erased slots must read as "nothing to import", not as a record. */
+    memset(slot,255,sizeof(slot));
+    CHECK(mttl_settings_choose(slot[0],slot[1])==-1);
+    CHECK(!mttl_settings_extract(slot[0],extract,sizeof(extract),&m));
+}
+
