diff --git a/source/standalone/firmware/sdk_settings_flash.c b/source/standalone/firmware/sdk_settings_flash.c
index 4197ebc..adce0cf 100644
--- a/source/standalone/firmware/sdk_settings_flash.c
+++ b/source/standalone/firmware/sdk_settings_flash.c
@@ -1,14 +1,19 @@
 #include "sdk_settings_flash.h"
+#include "settings_record.h"
 #include "flash_api.h"
 #include "device_lock.h"
 #include "FreeRTOS.h"
 #include "sdk_memory.h"
 #include <string.h>
 extern flash_t flash;
-/* Worker-owned append journal, two 64KiB banks; no legacy import. */
+/* Worker-owned append journal, two 64KiB banks. The 2.0.x record is imported
+ * once (see legacy_import) so an upgrade keeps the stored configuration. */
 #define RECORD 1024u
 #define COMMIT 1020u
 #define COUNT 128u
+#define LEGACY_SLOT 2048u
+#define LEGACY_BODY 1216u
+static const uint32_t legacy_sectors[2]={0xee000,0xef000};
 static int scanned,latest=-1;
 static uint32_t sequence;
 static uint32_t address(unsigned s){return s<64?0x70000u+s*RECORD:0xe0000u+(s-64)*RECORD;}
@@ -49,10 +54,42 @@ static int program(unsigned s,unsigned off,const uint8_t *b,unsigned n){uint8_t
  ok=flash_stream_write(&flash,a,n,(uint8_t *)b)>=0&&flash_stream_read(&flash,a,n,check)==1&&!memcmp(check,b,n);
  device_mutex_unlock(RT_DEV_LOCK_FLASH);memset(check,0,sizeof(check));return ok;
 }
+/* 2.0.x kept a v8 record in each of two 2 KiB slots at 0xEE000/0xEF000.
+ * 2.1.0 deliberately starts a new journal instead of migrating. This fork
+ * reads the newer legacy slot once on the first boot after an upgrade, so the
+ * upgrade keeps Wi-Fi, MQTT, names, per-channel limits, the lock, the timers,
+ * the schedule, the dashboard language and the energy checkpoints. Both legacy
+ * sectors are erased after the first journal write, so the import runs at most
+ * once and stale settings can never come back. */
+static int legacy_read(uint8_t *slot,unsigned which){
+ unsigned i;int ok=1;if(which>1)return 0;
+ device_mutex_lock(RT_DEV_LOCK_FLASH);
+ for(i=0;i<LEGACY_SLOT;i+=256)if(flash_stream_read(&flash,legacy_sectors[which]+i,256,slot+i)!=1){ok=0;break;}
+ device_mutex_unlock(RT_DEV_LOCK_FLASH);return ok;
+}
+static int legacy_import(mttl_settings *out){
+ uint8_t *slot,*body;size_t n=0;int pick,ok=0;
+ if(!out)return 0;
+ slot=pvPortMalloc(LEGACY_SLOT*2);if(!slot)return 0;
+ body=pvPortMalloc(LEGACY_BODY);
+ if(body&&legacy_read(slot,0)&&legacy_read(slot+LEGACY_SLOT,1)){
+  pick=mttl_settings_choose(slot,slot+LEGACY_SLOT);
+  if(pick>=0&&mttl_settings_extract(slot+(unsigned)pick*LEGACY_SLOT,body,LEGACY_BODY,&n)&&
+     mttl_settings_storage_unpack(body,n,out))ok=1;
+ }
+ if(body){memset(body,0,LEGACY_BODY);vPortFree(body);}
+ memset(slot,0,LEGACY_SLOT*2);vPortFree(slot);return ok;
+}
 int mttl_sdk_settings_load(mttl_settings *out){uint8_t *b;int result=-1;
  if(!out||!geometry())return -1;scanned=0;latest=-1;sequence=0;
  b=pvPortMalloc(RECORD);if(!b)return -1;
- if(scan(b)){if(latest<0){mttl_settings_default(out);result=0;}
+ if(scan(b)){if(latest<0){
+   mttl_settings legacy;memset(&legacy,0,sizeof(legacy));
+   if(legacy_import(&legacy)){*out=legacy;result=mttl_sdk_settings_save(out)==1?1:0;
+    if(result==1){(void)erase(120,b);(void)erase(124,b);}}
+   else{mttl_settings_default(out);result=0;}
+   memset(&legacy,0,sizeof(legacy));
+  }
   else if(read_record((unsigned)latest,b)&&valid(b)&&mttl_settings_storage_unpack(b+16,word(b+8),out))result=1;}
  memset(b,0,RECORD);vPortFree(b);return result;
 }
