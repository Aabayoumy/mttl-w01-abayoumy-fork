diff --git a/source/standalone/tests/test_i18n.cjs b/source/standalone/tests/test_i18n.cjs
new file mode 100644
index 0000000..d2fcf62
--- /dev/null
+++ b/source/standalone/tests/test_i18n.cjs
@@ -0,0 +1,18 @@
+'use strict';
+/* English is the complete table; Egyptian Arabic covers the main page only and
+ * must fall back to English for every other key. The device build prunes both
+ * tables by the same literal-key scan, so a key used in an asset must resolve
+ * in the selected language. */
+const assert=require('assert');
+const i18n=require('../ui/i18n.js');
+const {en,ar}=i18n.messages;
+let checks=0;
+function check(name,fn){fn();checks++;}
+check('tables',()=>{assert.ok(en&&ar);assert.ok(Object.keys(en).length>Object.keys(ar).length);});
+check('arabic is a subset of english',()=>{for(const key of Object.keys(ar))assert.ok(key in en,'missing en key '+key);});
+check('every arabic entry is translated',()=>{for(const [key,value] of Object.entries(ar))assert.ok(/[\u0600-\u06ff]/.test(value),'untranslated '+key);});
+check('selects by language',()=>{assert.equal(i18n.text('ar','totalPower'),'القدرة الكلية');assert.equal(i18n.text('en','totalPower'),'Total Power');});
+check('falls back to english',()=>{assert.equal(i18n.text('ar','protection'),'Protection');assert.equal(i18n.text('xx','voltage'),'Voltage');assert.equal(i18n.text(undefined,'uptime'),'Uptime');});
+check('interpolation',()=>{assert.equal(i18n.text('ar','channelName',{number:3}),'اسم القناة 3');assert.equal(i18n.text('en','channelName',{number:3}),'Channel 3 name');});
+check('unknown key throws',()=>{assert.throws(()=>i18n.text('ar','nope'),/Missing translation/);});
+console.log(JSON.stringify({passed:true,checks,scope:'English/Arabic tables, fallback, interpolation'}));
