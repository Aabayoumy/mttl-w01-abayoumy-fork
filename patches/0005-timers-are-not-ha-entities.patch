@@ -78,10 +61,7 @@ static void publish_sample(mttl_device_app *d,const char *id,uint32_t now){
             if(mttl_mqtt_engine_publish(&d->mqtt,topic,(const uint8_t *)payload,strlen(payload),1,now)){d->mqtt_trip_mask=(uint8_t)live;d->mqtt_trip_reason=d->protection.reason;}
             return;
         }
-        for(ch=0;ch<4;ch++)if(!(d->mqtt_timer_known&(1u<<ch))||d->mqtt_timer_minutes[ch]!=d->settings.timer_minutes[ch]){
