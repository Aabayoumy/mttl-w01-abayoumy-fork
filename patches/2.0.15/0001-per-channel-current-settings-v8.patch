diff --git a/source/standalone/firmware/protection.c b/source/standalone/firmware/protection.c
index 86fd968..8d9c9f9 100644
--- a/source/standalone/firmware/protection.c
+++ b/source/standalone/firmware/protection.c
@@ -1,18 +1,52 @@
 #include "protection.h"
-void mttl_protection_default(mttl_protection_config *c){c->temperature_c=90;c->current_ma=16000;c->power_w=3000;c->enabled=7;}
-int mttl_protection_valid(const mttl_protection_config *c){return c&&c->temperature_c>=50&&c->temperature_c<=90&&c->current_ma>=1000&&c->current_ma<=16000&&c->power_w>=100&&c->power_w<=3000&&c->enabled<=7;}
+void mttl_protection_default(mttl_protection_config *c){
+    unsigned i;
+    c->temperature_c=90;c->current_ma=16000;c->power_w=3000;c->enabled=7;
+    for(i=0;i<MTTL_PROTECTION_CHANNELS;i++)c->channel_current_ma[i]=16000;
+}
+int mttl_protection_valid(const mttl_protection_config *c){
+    unsigned i;
+    if(!c||c->temperature_c<50||c->temperature_c>90||c->current_ma<1000||c->current_ma>16000||
+       c->power_w<100||c->power_w>3000||c->enabled>MTTL_PROTECTION_ENABLE_ALL)return 0;
+    for(i=0;i<MTTL_PROTECTION_CHANNELS;i++)if(c->channel_current_ma[i]<1000||c->channel_current_ma[i]>16000)return 0;
+    return 1;
+}
+/* Two-round confirmation never survives a reported trip. */
+static void clear_counts(mttl_protection_state *s){
+    unsigned i;s->current_count=s->power_count=0;
+    for(i=0;i<MTTL_PROTECTION_CHANNELS;i++)s->channel_current_count[i]=0;
+}
 unsigned mttl_protection_temperature(mttl_protection_state *s,const mttl_protection_config *c,int valid,int32_t t){
- unsigned reason=(c->enabled&1)&&valid&&t>(int32_t)c->temperature_c*10?1:0;
- if(reason){s->reason=1;s->current_count=s->power_count=0;}return reason;
+ unsigned reason=(c->enabled&MTTL_PROTECTION_ENABLE_TEMPERATURE)&&valid&&t>(int32_t)c->temperature_c*10?
+     MTTL_PROTECTION_REASON_TEMPERATURE:0;
+ if(reason){s->reason=(uint8_t)reason;s->channel_mask=0;clear_counts(s);}return reason;
 }
-unsigned mttl_protection_round(mttl_protection_state *s,const mttl_protection_config *c,unsigned valid,int32_t t,int32_t i,int32_t p){
- unsigned reason=0;if(!s||!mttl_protection_valid(c))return 0;
+unsigned mttl_protection_round(mttl_protection_state *s,const mttl_protection_config *c,unsigned valid,int32_t t,int32_t i,int32_t p,const int32_t *ci){
+ unsigned reason=0,ch,per_channel;uint8_t error=0,mask=0;
+ if(!s||!mttl_protection_valid(c))return 0;
  if(t<0)valid&=~1u;if(i<0)valid&=~2u;if(p<0)valid&=~4u;
- s->error_mask=(uint8_t)(c->enabled&~valid&7);
- if((c->enabled&valid&1)&&t>(int32_t)c->temperature_c*10)reason|=1;
- if((c->enabled&valid&2)&&i>c->current_ma){if(s->current_count<2)++s->current_count;}else s->current_count=0;
- if((c->enabled&valid&4)&&p>(int32_t)c->power_w*1000){if(s->power_count<2)++s->power_count;}else s->power_count=0;
- if(s->current_count==2)reason|=2;if(s->power_count==2)reason|=4;
- if(reason){s->reason=(uint8_t)reason;s->current_count=s->power_count=0;}
+ /* A missing reading for this round reports every limit that depends on it. */
+ if(!(valid&1))error|=MTTL_PROTECTION_ENABLE_TEMPERATURE;
+ if(!(valid&2))error|=MTTL_PROTECTION_ENABLE_CURRENT|MTTL_PROTECTION_ENABLE_CHANNEL_CURRENT;
+ if(!(valid&4))error|=MTTL_PROTECTION_ENABLE_POWER;
+ s->error_mask=(uint8_t)(c->enabled&error&MTTL_PROTECTION_ENABLE_ALL);
+ if((c->enabled&valid&MTTL_PROTECTION_ENABLE_TEMPERATURE)&&t>(int32_t)c->temperature_c*10)reason|=MTTL_PROTECTION_REASON_TEMPERATURE;
+ if((c->enabled&valid&MTTL_PROTECTION_ENABLE_CURRENT)&&i>c->current_ma){if(s->current_count<2)++s->current_count;}else s->current_count=0;
+ if((c->enabled&valid&MTTL_PROTECTION_ENABLE_POWER)&&p>(int32_t)c->power_w*1000){if(s->power_count<2)++s->power_count;}else s->power_count=0;
+ if(s->current_count==2)reason|=MTTL_PROTECTION_REASON_CURRENT;
+ if(s->power_count==2)reason|=MTTL_PROTECTION_REASON_POWER;
+ /* The per-channel limit shares the aggregate two-round confirmation and is
+  * only judged on rounds that actually read all four channels. */
+ per_channel=(c->enabled&MTTL_PROTECTION_ENABLE_CHANNEL_CURRENT)&&(valid&2u)&&ci?1u:0u;
+ for(ch=0;ch<MTTL_PROTECTION_CHANNELS;ch++){
+   if(per_channel&&ci[ch]>=0&&ci[ch]>c->channel_current_ma[ch]){
+       /* At most one trip per round: the first channel over its limit reports. */
+       if(++s->channel_current_count[ch]>=2){
+           reason|=MTTL_PROTECTION_REASON_CURRENT;mask|=(uint8_t)(1u<<ch);
+           s->channel_current_count[ch]=0;
+       }
+   }else s->channel_current_count[ch]=0;
+ }
+ if(reason){s->reason=(uint8_t)reason;s->channel_mask=mask;clear_counts(s);}
  return reason;
 }
diff --git a/source/standalone/firmware/protection.h b/source/standalone/firmware/protection.h
index d7fbf57..5dbe10e 100644
--- a/source/standalone/firmware/protection.h
+++ b/source/standalone/firmware/protection.h
@@ -1,15 +1,44 @@
 #ifndef MTTL_PROTECTION_H
 #define MTTL_PROTECTION_H
 #include <stdint.h>
-typedef struct {uint16_t temperature_c,current_ma,power_w;uint8_t enabled;} mttl_protection_config;
-typedef struct {uint8_t current_count,power_count,error_mask,reason;} mttl_protection_state;
+#define MTTL_PROTECTION_CHANNELS 4
+/* mttl_protection_config.enabled bits. 0..2 keep the shipped v4..v7 meaning so
+ * stored records, the /api/config projection and the existing MQTT contract are
+ * unchanged; bit 3 is the per-channel limit introduced with settings v8.
+ *
+ * Only current is per-channel: on one mains supply a per-channel power limit is
+ * the same judgement at a fixed voltage, and BD_RAM here has ~1.6 KB of slack in
+ * total for code, rodata and the gzipped UI combined. */
+#define MTTL_PROTECTION_ENABLE_TEMPERATURE     0x01u
+#define MTTL_PROTECTION_ENABLE_CURRENT         0x02u
+#define MTTL_PROTECTION_ENABLE_POWER           0x04u
+#define MTTL_PROTECTION_ENABLE_CHANNEL_CURRENT 0x08u
+#define MTTL_PROTECTION_ENABLE_ALL             0x0fu
+/* reason/error_mask use the enable-bit numbering above. */
+#define MTTL_PROTECTION_REASON_TEMPERATURE 0x01u
+#define MTTL_PROTECTION_REASON_CURRENT     0x02u
+#define MTTL_PROTECTION_REASON_POWER       0x04u
+typedef struct {
+    uint16_t temperature_c; /* deci-C limit for the highest fresh channel */
+    uint16_t current_ma;    /* corrected aggregate current limit */
+    uint16_t power_w;       /* aggregate power limit */
+    uint16_t channel_current_ma[MTTL_PROTECTION_CHANNELS];
+    uint8_t enabled;
+} mttl_protection_config;
+typedef struct {
+    uint8_t current_count,power_count,error_mask,reason;
+    uint8_t channel_current_count[MTTL_PROTECTION_CHANNELS];
+    uint8_t channel_mask; /* Bit per channel: held the last reported trip. */
+} mttl_protection_state;
 void mttl_protection_default(mttl_protection_config *);
 int mttl_protection_valid(const mttl_protection_config *);
 unsigned mttl_protection_temperature(mttl_protection_state *,const mttl_protection_config *,int valid,int32_t temperature_dc);
 /* Called once per completed NEW measurement round, never from cached UI data.
  * valid bits: temperature=1, corrected total current=2, total power=4.
  * Temperature caller supplies maximum fresh channel temperature in deci-C.
- * Current is corrected mA; power is the existing aggregate in mW.
+ * Aggregate current is corrected mA; aggregate power is mW.
+ * channel_current_ma is a four-entry array of that round's corrected per-channel
+ * current in mA, or NULL when the round read fewer than four channels.
  * Returns reason bits requesting ALL OFF, not a lock. No output side effects. */
-unsigned mttl_protection_round(mttl_protection_state *,const mttl_protection_config *,unsigned valid,int32_t temperature_dc,int32_t current_ma,int32_t power_mw);
+unsigned mttl_protection_round(mttl_protection_state *,const mttl_protection_config *,unsigned valid,int32_t temperature_dc,int32_t current_ma,int32_t power_mw,const int32_t *channel_current_ma);
 #endif
diff --git a/source/standalone/firmware/sdk_meter.c b/source/standalone/firmware/sdk_meter.c
index ab314ef..749c08a 100644
--- a/source/standalone/firmware/sdk_meter.c
+++ b/source/standalone/firmware/sdk_meter.c
@@ -10,16 +10,17 @@ static mttl_meter_power_state power_state;static mttl_meter_power_input power_in
 static uint8_t energy_reads;static uint32_t energy_raw[4];
 static uint8_t protection_event,temperature_reads,round_current,round_power,last_channel;
 unsigned mttl_sdk_meter_protection(const mttl_hardware_samples *s,const mttl_protection_config *c,mttl_protection_state *p){
- unsigned reason=0,valid=0,i;int32_t current=0,power=0;uint8_t event=protection_event;protection_event=0;
+ unsigned reason=0,valid=0,i;int32_t current=0,power=0,channel_current[4]={0,0,0,0};uint8_t event=protection_event;protection_event=0;
  if(!event)return 0;
  p->error_mask=(uint8_t)(c->enabled&((p->error_mask&6)|(temperature_reads==15?0:1)));
  if(event&1)reason=mttl_protection_temperature(p,c,(temperature_reads>>last_channel)&1,s->temperature[last_channel].value);
  if(event&2){p->error_mask=(uint8_t)(c->enabled&((p->error_mask&1)|(round_current==15?0:2)|(round_power==15?0:4)));
  if(reason)return reason;
- if(round_current==15){valid|=2;for(i=0;i<4;i++)current+=s->current[i].value;}
+ if(round_current==15){valid|=2;for(i=0;i<4;i++){current+=s->current[i].value;channel_current[i]=s->current[i].value;}}
   if(round_power==15){valid|=4;for(i=0;i<4;i++)power+=s->power[i].value;}
-  /* Temperature was evaluated at each fresh channel read, not again here. */
-  {mttl_protection_config cp=*c;unsigned error=p->error_mask;cp.enabled&=6;reason|=mttl_protection_round(p,&cp,valid,0,current,power);p->error_mask=(uint8_t)error;}
+  /* Temperature was evaluated at each fresh channel read, not again here.
+   * The per-channel array is only handed over for complete rounds. */
+  {mttl_protection_config cp=*c;unsigned error=p->error_mask;cp.enabled&=MTTL_PROTECTION_ENABLE_ALL&~MTTL_PROTECTION_ENABLE_TEMPERATURE;reason|=mttl_protection_round(p,&cp,valid,0,current,power,round_current==15?channel_current:0);p->error_mask=(uint8_t)error;}
  }return reason;
 }
 static void (*service_network)(void);
