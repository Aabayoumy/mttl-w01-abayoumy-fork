diff --git a/source/standalone/host_test/protection_settings_test.c b/source/standalone/host_test/protection_settings_test.c
new file mode 100644
index 0000000..224633e
--- /dev/null
+++ b/source/standalone/host_test/protection_settings_test.c
@@ -0,0 +1,266 @@
+/* Host-side regression test for the two modules whose defects are silent on the
+ * device: protection.c (trip logic, units, confirmation) and settings.c (the
+ * versioned codec that owns the stored Wi-Fi/MQTT credentials).
+ *
+ * Build with source/standalone/host_test/run.sh. Nothing in the firmware build
+ * references this file; the on-target selftest.c stays as it is.
+ */
+#include <stdio.h>
+#include <string.h>
+#include "protection.h"
+#include "settings.h"
+
+static unsigned total, failures;
+#define CHECK(x) do{total++;if(!(x)){failures++;printf("FAIL %s:%d: %s\n",__FILE__,__LINE__,#x);}}while(0)
+
+/* Older layouts for a version byte, in bytes, taken from mttl_settings_unpack. */
+static size_t older_tail(uint8_t version){
+    switch(version){case 1:return 0;case 4:return 7;case 5:return 57;case 6:return 58;case 7:return 66;case 8:return 74;}
+    return 74;
+}
+/* Re-cut a packed v8 body to look like a record written by an older firmware. */
+static size_t legacy(const uint8_t *v8,size_t n,uint8_t version,uint8_t *out){
+    size_t size=n-(74-older_tail(version));
+    memcpy(out,v8,size);out[0]=version;return size;
+}
+
+/* Field-by-field so struct padding can never make this test lie. */
+static int same_protection(const mttl_protection_config *x,const mttl_protection_config *y){
+    unsigned i;
+    if(x->temperature_c!=y->temperature_c||x->current_ma!=y->current_ma||x->power_w!=y->power_w||x->enabled!=y->enabled)return 0;
+    for(i=0;i<MTTL_PROTECTION_CHANNELS;i++)if(x->channel_current_ma[i]!=y->channel_current_ma[i])return 0;
+    return 1;
+}
+
+static void test_protection_aggregate(void){
+    mttl_protection_config c;mttl_protection_state p;
+    memset(&p,0,sizeof(p));mttl_protection_default(&c);
+    CHECK(mttl_protection_valid(&c));
+    CHECK(c.enabled==7);
+    CHECK(c.temperature_c==90&&c.current_ma==16000&&c.power_w==3000);
+    CHECK(c.channel_current_ma[0]==16000&&c.channel_current_ma[3]==16000);
+    /* Limits are inclusive (never trips at the limit itself). */
+    CHECK(!mttl_protection_round(&p,&c,7,900,16000,3000000,0));
+    CHECK(mttl_protection_round(&p,&c,7,901,0,0,0)==MTTL_PROTECTION_REASON_TEMPERATURE);
+    /* Aggregate current and power need two consecutive over-limit rounds. */
+    memset(&p,0,sizeof(p));
+    CHECK(!mttl_protection_round(&p,&c,7,0,16001,3000001,0)&&p.current_count==1&&p.power_count==1);
+    CHECK(mttl_protection_round(&p,&c,7,0,16001,3000001,0)==(MTTL_PROTECTION_REASON_CURRENT|MTTL_PROTECTION_REASON_POWER));
+    CHECK(!p.current_count&&!p.power_count);
+    /* A third over-limit round restarts the confirmation, it does not re-trip. */
+    CHECK(!mttl_protection_round(&p,&c,7,0,16001,3000001,0)&&p.current_count==1);
+    /* A one-round recovery clears the pending confirmation. */
+    memset(&p,0,sizeof(p));
+    CHECK(!mttl_protection_round(&p,&c,7,0,16001,3000001,0)&&p.current_count==1);
+    CHECK(!mttl_protection_round(&p,&c,7,0,16000,0,0)&&!p.current_count);
+    /* Aggregate power is stored in W and sampled in mW: exactly at the limit
+     * must never trip. */
+    memset(&p,0,sizeof(p));
+    CHECK(!mttl_protection_round(&p,&c,4,0,0,3000000,0));
+    CHECK(!mttl_protection_round(&p,&c,4,0,0,3000000,0)&&!p.power_count);
+    CHECK(!mttl_protection_round(&p,&c,4,0,0,3000001,0));
+    CHECK(mttl_protection_round(&p,&c,4,0,0,3000001,0)==MTTL_PROTECTION_REASON_POWER);
+    /* Stale readings report an error and never trip. */
+    memset(&p,0,sizeof(p));
+    CHECK(!mttl_protection_round(&p,&c,1,0,16001,3000001,0));
+    CHECK(p.error_mask==(MTTL_PROTECTION_ENABLE_CURRENT|MTTL_PROTECTION_ENABLE_POWER));
+    CHECK(!p.current_count&&!p.power_count);
+    memset(&p,0,sizeof(p));
+    CHECK(!mttl_protection_round(&p,&c,0,9999,99999,9999999,0));
+    CHECK(p.error_mask==7); /* Only enabled limits are reported, never the others. */
+    c.enabled=MTTL_PROTECTION_ENABLE_ALL;memset(&p,0,sizeof(p));
+    CHECK(!mttl_protection_round(&p,&c,0,0,0,0,0)&&p.error_mask==MTTL_PROTECTION_ENABLE_ALL);
+    c.enabled=7;
+    /* Disabled limits never trip and never report. */
+    c.enabled=0;
+    CHECK(!mttl_protection_round(&p,&c,7,9999,99999,9999999,0)&&!p.error_mask);
+    /* Negative inputs mean "no reading this round". */
+    mttl_protection_default(&c);memset(&p,0,sizeof(p));
+    CHECK(!mttl_protection_round(&p,&c,7,-1,-1,-1,0)&&!p.current_count&&!p.power_count);
+}
+
+static void test_protection_bounds(void){
+    mttl_protection_config c;unsigned i;mttl_protection_default(&c);
+    CHECK(mttl_protection_valid(&c));
+    c.temperature_c=49;CHECK(!mttl_protection_valid(&c));
+    c.temperature_c=50;CHECK(mttl_protection_valid(&c));
+    c.temperature_c=91;CHECK(!mttl_protection_valid(&c));
+    c.temperature_c=90;
+    c.current_ma=999;CHECK(!mttl_protection_valid(&c));
+    c.current_ma=1000;CHECK(mttl_protection_valid(&c));
+    c.current_ma=16001;CHECK(!mttl_protection_valid(&c));
+    c.current_ma=16000;
+    c.power_w=99;CHECK(!mttl_protection_valid(&c));
+    c.power_w=100;CHECK(mttl_protection_valid(&c));
+    c.power_w=3001;CHECK(!mttl_protection_valid(&c));
+    c.power_w=3000;
+    /* Every settings v8 enable bit is accepted, and nothing above it is. */
+    c.enabled=MTTL_PROTECTION_ENABLE_ALL;CHECK(mttl_protection_valid(&c));
+    c.enabled=MTTL_PROTECTION_ENABLE_ALL+1;CHECK(!mttl_protection_valid(&c));
+    c.enabled=0;CHECK(mttl_protection_valid(&c));
+    mttl_protection_default(&c);
+    for(i=0;i<MTTL_PROTECTION_CHANNELS;i++){
+        c.channel_current_ma[i]=999;CHECK(!mttl_protection_valid(&c));c.channel_current_ma[i]=1000;
+        c.channel_current_ma[i]=16001;CHECK(!mttl_protection_valid(&c));c.channel_current_ma[i]=16000;
+    }
+    CHECK(mttl_protection_valid(&c));
+    CHECK(!mttl_protection_valid(0));
+}
+
+static void test_protection_per_channel(void){
+    mttl_protection_config c;mttl_protection_state p;int32_t ci[4]={0,0,0,0};
+    /* Overcurrent on one outlet only. */
+    mttl_protection_default(&c);memset(&p,0,sizeof(p));
+    c.enabled=MTTL_PROTECTION_ENABLE_CHANNEL_CURRENT;c.channel_current_ma[2]=1000;ci[2]=1001;
+    CHECK(!mttl_protection_round(&p,&c,2|4,0,0,0,ci)&&!p.channel_mask);
+    CHECK(mttl_protection_round(&p,&c,2|4,0,0,0,ci)==MTTL_PROTECTION_REASON_CURRENT);
+    CHECK(p.channel_mask==(1u<<2));
+    /* Recovery resets the per-channel confirmation. */
+    ci[2]=1000;
+    CHECK(!mttl_protection_round(&p,&c,2|4,0,0,0,ci)&&!p.channel_current_count[2]);
+    /* A round that read fewer than four channels has no per-channel opinion. */
+    ci[2]=9999;
+    CHECK(!mttl_protection_round(&p,&c,2|4,0,0,0,0));
+    CHECK(!mttl_protection_round(&p,&c,2|4,0,0,0,0)&&!p.channel_current_count[2]);
+    CHECK(p.channel_mask==(1u<<2)); /* Attribution stays with the last trip. */
+    /* Clearing the enable bit stops judging; the last trip stays reported. */
+    c.enabled=0;
+    CHECK(!mttl_protection_round(&p,&c,2|4,0,0,0,ci)&&p.channel_mask==(1u<<2));
+    /* Two outlets at once report both. */
+    mttl_protection_default(&c);memset(&p,0,sizeof(p));
+    c.enabled=MTTL_PROTECTION_ENABLE_CHANNEL_CURRENT;
+    c.channel_current_ma[0]=1000;c.channel_current_ma[1]=1000;ci[0]=1001;ci[1]=1001;
+    CHECK(!mttl_protection_round(&p,&c,2|4,0,0,0,ci));
+    CHECK(mttl_protection_round(&p,&c,2|4,0,0,0,ci)==MTTL_PROTECTION_REASON_CURRENT&&p.channel_mask==3);
+    /* The per-channel limit is judged independently of the aggregate one. */
+    mttl_protection_default(&c);memset(&p,0,sizeof(p));
+    c.enabled=MTTL_PROTECTION_ENABLE_CURRENT|MTTL_PROTECTION_ENABLE_CHANNEL_CURRENT;
+    c.channel_current_ma[0]=1000;ci[0]=1001;
+    CHECK(!mttl_protection_round(&p,&c,2|4,0,1000,0,ci));
+    CHECK(mttl_protection_round(&p,&c,2|4,0,1000,0,ci)==MTTL_PROTECTION_REASON_CURRENT&&p.channel_mask==1);
+    /* Same round, but the aggregate limit trips first and separately. */
+    memset(&p,0,sizeof(p));
+    CHECK(!mttl_protection_round(&p,&c,2|4,0,16001,0,ci));
+    CHECK(mttl_protection_round(&p,&c,2|4,0,16001,0,ci)==MTTL_PROTECTION_REASON_CURRENT);
+    CHECK(p.channel_mask==1);
+    /* Per-channel protection inherits the same error reporting. */
+    memset(&p,0,sizeof(p));c.enabled=MTTL_PROTECTION_ENABLE_CHANNEL_CURRENT;
+    CHECK(!mttl_protection_round(&p,&c,4,0,0,0,0));
+    CHECK(p.error_mask==MTTL_PROTECTION_ENABLE_CHANNEL_CURRENT);
+    /* An invalid configuration is refused rather than acted on. */
+    c.channel_current_ma[0]=0;memset(&p,0,sizeof(p));
+    CHECK(!mttl_protection_round(&p,&c,2|4,0,0,0,ci)&&!p.reason);
+}
+
+static void test_settings_v8(void){
+    mttl_settings a,b;uint8_t body[512];size_t n,i;
+    mttl_settings_default(&a);
+    n=mttl_settings_pack(&a,body,sizeof(body));
+    /* Wire-format pin: 5 header + 11 length prefixes + 28 string bytes + v8 tail. */
+    CHECK(n==118);
+    CHECK(body[0]==8);
+    CHECK(mttl_settings_unpack(body,n,&b));
+    CHECK(same_protection(&a.protection,&b.protection));
+    CHECK(b.protection.enabled==7&&b.protection.channel_current_ma[2]==16000);
+    /* A short buffer must never emit a partial credential record. */
+    CHECK(!mttl_settings_pack(&a,body,n-1));
+    /* Distinct per-channel limits survive the round trip. */
+    mttl_settings_default(&a);
+    a.protection.enabled=MTTL_PROTECTION_ENABLE_ALL;
+    for(i=0;i<4;i++)a.protection.channel_current_ma[i]=(uint16_t)(1000+100*i);
+    n=mttl_settings_pack(&a,body,sizeof(body));
+    CHECK(n==118&&mttl_settings_unpack(body,n,&b));
+    for(i=0;i<4;i++)CHECK(b.protection.channel_current_ma[i]==1000+100*i);
+    CHECK(b.protection.enabled==MTTL_PROTECTION_ENABLE_ALL);
+    /* The web encoder must emit little-endian per-channel limits in channel order. */
+    mttl_settings_default(&a);
+    a.protection.channel_current_ma[0]=1000;a.protection.channel_current_ma[1]=0x1234;
+    a.protection.channel_current_ma[2]=0x3abc;a.protection.channel_current_ma[3]=16000;
+    n=mttl_settings_pack(&a,body,sizeof(body));
+    CHECK(n==118);
+    CHECK(body[n-8]==0xe8&&body[n-7]==0x03);
+    CHECK(body[n-6]==0x34&&body[n-5]==0x12);
+    CHECK(body[n-4]==0xbc&&body[n-3]==0x3a);
+    CHECK(body[n-2]==0x80&&body[n-1]==0x3e);
+    /* Storage wrapper keeps the device-owned checkpoint around a v8 body. */
+    mttl_settings_default(&a);
+    a.protection.channel_current_ma[1]=1234;
+    a.relay_known=15;a.relay_on=2;a.energy_valid=1;a.energy_wh[0]=1234;a.energy_raw[1]=99;
+    n=mttl_settings_storage_pack(&a,body,sizeof(body));
+    CHECK(n==118+38);
+    CHECK(mttl_settings_storage_unpack(body,n,&b));
+    CHECK(b.protection.channel_current_ma[1]==1234);
+    CHECK(b.relay_known==15&&b.relay_on==2&&b.energy_valid==1&&b.energy_wh[0]==1234&&b.energy_raw[1]==99);
+}
+
+static void test_settings_rejections(void){
+    mttl_settings a,b;uint8_t body[512],old[512];size_t n;
+    mttl_settings_default(&a);
+    a.protection.temperature_c=65;a.protection.current_ma=2300;a.protection.power_w=750;
+    a.protection.enabled=MTTL_PROTECTION_ENABLE_ALL;
+    a.protection.channel_current_ma[0]=1000;
+    n=mttl_settings_pack(&a,body,sizeof(body));
+    CHECK(n==118);
+    /* Defect guard: the version byte must move with the tail length. A v8 body
+     * relabelled as v7 is rejected instead of being silently mis-parsed. */
+    memcpy(old,body,n);old[0]=7;CHECK(!mttl_settings_unpack(old,n,&b));
+    memcpy(old,body,n);old[0]=8;CHECK(mttl_settings_unpack(old,n,&b)&&b.protection.channel_current_ma[0]==1000);
+    /* Unknown enable bits are refused, not masked off. */
+    memcpy(old,body,n);old[n-74]=16;CHECK(!mttl_settings_unpack(old,n,&b));
+    /* Per-channel limits are range checked like the aggregate pair. */
+    memcpy(old,body,n);old[n-8]=0xe7;old[n-7]=0x03;CHECK(!mttl_settings_unpack(old,n,&b)); /* 999 mA */
+    memcpy(old,body,n);old[n-8]=0xe8;old[n-7]=0x03;CHECK(mttl_settings_unpack(old,n,&b));  /* 1000 mA */
+    memcpy(old,body,n);old[n-8]=0x81;old[n-7]=0x3e;CHECK(!mttl_settings_unpack(old,n,&b)); /* 16001 mA */
+    /* A v8 body missing its per-channel tail is refused. */
+    CHECK(!mttl_settings_unpack(body,n-1,&b));
+    CHECK(!mttl_settings_unpack(body,n+1,&b));
+}
+
+static void test_settings_migration(void){
+    mttl_settings a,b;uint8_t body[512],old[512];size_t n,len;
+    /* Exactly the upgrade path of a device holding a v4..v7 record: aggregate
+     * limits are restored and the per-channel limits fall back to defaults. */
+    mttl_settings_default(&a);
+    a.protection.temperature_c=65;a.protection.current_ma=2300;a.protection.power_w=750;a.protection.enabled=14;
+    a.protection.channel_current_ma[0]=1000;a.protection.channel_current_ma[1]=2000;
+    a.protection.channel_current_ma[2]=3000;a.protection.channel_current_ma[3]=4000;
+    a.button_lock=5;a.timer_minutes[2]=30;
+    n=mttl_settings_pack(&a,body,sizeof(body));
+    CHECK(n==118);
+    /* v8 keeps everything. */
+    CHECK(mttl_settings_unpack(body,n,&b));
+    CHECK(b.protection.channel_current_ma[1]==2000&&b.timer_minutes[2]==30&&b.button_lock==5);
+    /* v4: no schedule, no lock, no timers, no per-channel limits. */
+    len=legacy(body,n,4,old);CHECK(len==n-67);CHECK(mttl_settings_unpack(old,len,&b));
+    CHECK(b.protection.temperature_c==65&&b.protection.current_ma==2300&&b.protection.power_w==750&&b.protection.enabled==14);
+    CHECK(b.protection.channel_current_ma[0]==16000&&b.protection.channel_current_ma[3]==16000&&!b.button_lock&&!b.timer_minutes[2]);
+    {mttl_schedule_config def;mttl_schedule_default(&def);CHECK(!memcmp(&b.schedule,&def,sizeof(def)));}
+    /* v5, v6, v7 all land on the same per-channel defaults. */
+    len=legacy(body,n,5,old);CHECK(len==n-17);CHECK(mttl_settings_unpack(old,len,&b)&&b.protection.channel_current_ma[3]==16000&&!b.button_lock);
+    len=legacy(body,n,6,old);CHECK(len==n-16);CHECK(mttl_settings_unpack(old,len,&b)&&b.protection.channel_current_ma[0]==16000&&b.button_lock==5&&!b.timer_minutes[2]);
+    len=legacy(body,n,7,old);CHECK(len==n-8);CHECK(mttl_settings_unpack(old,len,&b));
+    CHECK(b.protection.channel_current_ma[0]==16000&&b.protection.channel_current_ma[3]==16000);
+    CHECK(b.protection.temperature_c==65&&b.protection.current_ma==2300&&b.protection.power_w==750);
+    CHECK(b.protection.enabled==14&&b.button_lock==5&&b.timer_minutes[2]==30);
+    /* v1 predates protection entirely. */
+    len=legacy(body,n,1,old);CHECK(len==n-74);CHECK(mttl_settings_unpack(old,len,&b));
+    CHECK(b.protection.enabled==7&&b.protection.temperature_c==90&&b.protection.channel_current_ma[0]==16000&&!b.button_lock);
+    /* Rewriting a migrated record persists the per-channel defaults. */
+    n=mttl_settings_pack(&b,body,sizeof(body));
+    CHECK(n==118);
+    CHECK(mttl_settings_unpack(body,n,&a));
+    CHECK(a.protection.channel_current_ma[0]==16000&&a.protection.temperature_c==90);
+    /* Nothing in a migrated record lost the Wi-Fi or broker credentials. */
+    CHECK(!strcmp(b.device,"MTTL-W01")&&b.port==1883&&!strcmp(b.topic,"mttl"));
+}
+
+int main(void){
+    test_protection_aggregate();
+    test_protection_bounds();
+    test_protection_per_channel();
+    test_settings_v8();
+    test_settings_rejections();
+    test_settings_migration();
+    printf("%s: %u checks, %u failed\n",failures?"FAILED":"PASSED",total,failures);
+    return failures?1:0;
+}
diff --git a/source/standalone/host_test/run.sh b/source/standalone/host_test/run.sh
