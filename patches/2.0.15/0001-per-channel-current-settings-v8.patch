index 0000000..bb79ca0
--- /dev/null
+++ b/source/standalone/host_test/run.sh
@@ -0,0 +1,18 @@
+#!/bin/sh
+# Host-side unit test for the standalone firmware's protection and settings
+# modules. Pure C, no device, no cross toolchain, no Python.
+#
+#   sh source/standalone/host_test/run.sh
+#
+# Exit status is non-zero when any check fails.
+set -e
+CC=${CC:-cc}
+HERE=$(cd "$(dirname "$0")" && pwd)
+FW=$HERE/../firmware
+OUT=${TMPDIR:-/tmp}/mttl_host_test
+mkdir -p "$OUT"
+"$CC" -std=c99 -Wall -Wextra -Werror -O1 \
+    -I"$FW" \
+    "$HERE/protection_settings_test.c" "$FW/protection.c" "$FW/settings.c" "$FW/scheduler.c" \
+    -o "$OUT/protection_settings_test"
+exec "$OUT/protection_settings_test"
