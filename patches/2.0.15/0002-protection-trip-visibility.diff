     CHECK(mttl_protection_round(&p,&c,6,0,1001,0,ci)&&p.cut_mask);
 }
 
+/* The HA entity contract. The trip sensor is appended, so every shipped index
+ * must keep its component, key and state topic. */
+static void test_ha_trip_discovery(void){
+    mttl_settings s;char topic[192],json[1024];size_t n;
+    mttl_settings_default(&s);
+    strcpy(s.device,"MTTL-Test");
+    strcpy(s.channel[0],"TV");strcpy(s.channel[1],"SBar");
+    strcpy(s.channel[2],"SW 3");strcpy(s.channel[3],"SW 4");
+    CHECK(MTTL_HA_ENTITIES==34&&MTTL_HA_TRIP_INDEX==MTTL_HA_ENTITIES-1);
+    n=mttl_ha_discovery(&s,"aabbccddeeff",MTTL_HA_TRIP_INDEX,topic,sizeof(topic),json,sizeof(json));
+    CHECK(n>0&&n<sizeof(json));
+    CHECK(!strcmp(topic,"homeassistant/sensor/mttl_cddeeff_protection/config"));
+    CHECK(strstr(json,"\"stat_t\":\"~/protection\"")!=0);
+    CHECK(strstr(json,"\"uniq_id\":\"mttl_cddeeff_protection\"")!=0);
+    CHECK(strstr(json,"\"default_entity_id\":\"sensor.mttl_cddeeff_protection\"")!=0);
+    CHECK(strstr(json,"\"name\":\"Protection\"")!=0);
+    CHECK(strstr(json,"\"ent_cat\":\"diagnostic\"")!=0);
+    CHECK(strstr(json,"\"avty_t\":\"~/availability\"")!=0);
+    /* The state is the cut mask out of the published JSON object, the rest of
+     * that object becomes attributes, and it must not expire like a sample. */
+    CHECK(strstr(json,"\"val_tpl\":\"{{ value_json.mask }}\"")!=0);
+    CHECK(strstr(json,"\"json_attr_t\":\"~/protection\"")!=0);
+    CHECK(strstr(json,"\"exp_aft\"")==0);
+    CHECK(mttl_ha_discovery(&s,"aabbccddeeff",0,topic,sizeof(topic),json,sizeof(json))>0&&
+          !strcmp(topic,"homeassistant/switch/mttl_cddeeff_all/config"));
+    CHECK(mttl_ha_discovery(&s,"aabbccddeeff",5,topic,sizeof(topic),json,sizeof(json))>0&&
+          !strcmp(topic,"homeassistant/sensor/mttl_cddeeff_powerall/config"));
+    CHECK(mttl_ha_discovery(&s,"aabbccddeeff",25,topic,sizeof(topic),json,sizeof(json))>0&&
+          !strcmp(topic,"homeassistant/number/mttl_cddeeff_timer1/config"));
+    CHECK(mttl_ha_discovery(&s,"aabbccddeeff",32,topic,sizeof(topic),json,sizeof(json))>0&&
+          !strcmp(topic,"homeassistant/sensor/mttl_cddeeff_timer_remaining4/config"));
+    CHECK(!mttl_ha_discovery(&s,"aabbccddeeff",MTTL_HA_ENTITIES,topic,sizeof(topic),json,sizeof(json)));
+}
+
 int main(void){
     test_protection_aggregate();
     test_protection_bounds();
     test_protection_per_channel();
     test_protection_cut_policy();
+    test_ha_trip_discovery();
     test_settings_v8();
     test_settings_rejections();
     test_settings_migration();
