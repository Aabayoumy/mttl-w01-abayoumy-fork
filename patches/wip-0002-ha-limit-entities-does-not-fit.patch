+        snprintf(topic,sizeof(topic),"%s/chcurrent%u",base,ch+1);snprintf(payload,sizeof(payload),"%u.%u",ma/1000u,(ma%1000u)/100u);
+        if(mttl_mqtt_engine_publish(&d->mqtt,topic,(const uint8_t *)payload,strlen(payload),1,now)){d->mqtt_current_known|=1u<<ch;d->mqtt_current_ma[ch]=(uint16_t)ma;}return;
+    }}
     if(index>=5)d->publish_index=(uint8_t)(index+1<MTTL_HA_SAMPLE_ENTITIES?index+1:5);
     if(index<5){if(!index){if(d->control.known_mask!=15)return;strcpy(key,"all");strcpy(payload,d->control.on_mask==15?"ON":"OFF");}
