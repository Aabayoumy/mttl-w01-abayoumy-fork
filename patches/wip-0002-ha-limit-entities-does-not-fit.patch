+     if(mttl_settings_valid(&pending_config)){config_keep_password=1;config_occupied=config_ready=1;ok=1;}
+     else memset(&pending_config,0,sizeof(pending_config));}
+ }
+ taskEXIT_CRITICAL();return ok;
+}
