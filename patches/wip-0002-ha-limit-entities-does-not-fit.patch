     out->channel=channel;out->on=on;return 1;
 }
 
+/* The limit is entered in amps (matching the web UI slider) and stored in
+ * milliamps: "12.5" is exactly 12500, never a rounded binary float. */
+static int current_ma(const mttl_publish *p,unsigned *out){
+    unsigned frac=0,value=0,scale=100,i,digits;
+    if(!p->payload_size||p->payload_size>7)return 0;
+    digits=p->payload_size;
+    for(i=0;i<p->payload_size;i++){
+        uint8_t c=p->payload[i];
+        if(c=='.'){if(!i||frac||i+1==p->payload_size)return 0;digits=i;frac=p->payload_size-i-1;if(frac>3)return 0;break;}
+        if(c<'0'||c>'9')return 0;
+    }
+    if(!digits||digits>2)return 0;
+    for(i=0;i<digits;i++)value=value*10+p->payload[i]-'0';
+    value*=1000;
+    for(i=0;i<frac;i++){value+=(unsigned)(p->payload[digits+1+i]-'0')*scale;scale/=10;}
+    if(value<1000||value>16000)return 0;
+    *out=value;return 1;
+}
+int mttl_mq_current_command(const mttl_mqtt_session *s,uint32_t generation,const char *prefix,const uint8_t *frame,size_t size,uint8_t *channel,uint16_t *milliamps){
+ mttl_publish p;size_t n=0,i;unsigned value=0;
+ if(!s||!prefix||!channel||!milliamps||!mttl_parse_publish(frame,size,&p)||!mttl_mq_can_command(s,generation,p.retained))return 0;
+ while(n<128&&prefix[n])++n;
+ if(!n||n==128||p.topic_size!=n+15)return 0;
+ for(i=0;i<n;i++)if(p.topic[i]!=(uint8_t)prefix[i])return 0;
+ if(memcmp(p.topic+n,"/chcurrent",10)||p.topic[n+10]<'1'||p.topic[n+10]>'4'||memcmp(p.topic+n+11,"/set",4))return 0;
+ if(!current_ma(&p,&value))return 0;
+ *channel=(uint8_t)(p.topic[n+10]-'1');*milliamps=(uint16_t)value;return 1;
+}
+
 int mttl_mq_timer_command(const mttl_mqtt_session *s,uint32_t generation,const char *prefix,const uint8_t *frame,size_t size,uint8_t *channel,uint16_t *minutes){
  mttl_publish p;size_t n=0,i,digits;unsigned value=0;
  if(!s||!prefix||!channel||!minutes||!mttl_parse_publish(frame,size,&p)||!mttl_mq_can_command(s,generation,p.retained))return 0;
