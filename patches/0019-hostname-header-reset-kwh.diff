commit 98435e7585b6c153b50acf0d2343d51adb469c29
Author: Ahmed Bayoumy <abayoumy@outlook.com>
Date:   Sun Nov 1 20:18:20 2026 +0200

    UI+Firmware: device name in header; Reset kWh button on dashboard
    
    Header <h1> shows device name from settings via id="page-title" in
    render(). Controls row gains a Reset kWh button: POST /api/energy
    triggers mttl_sdk_energy_reset_request(); worker processes it
    asynchronously. UI gzip budget raised to 20,200 B in build_assets.py.
    
    Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>

diff --git a/source/standalone/build_assets.py b/source/standalone/build_assets.py
index 145b189..e403ec7 100644
--- a/source/standalone/build_assets.py
+++ b/source/standalone/build_assets.py
@@ -105,7 +105,7 @@ for i,(path,kind,data) in enumerate(sources):
     assert gzip.decompress(zipped)==data
     lines.append('static const unsigned char mttl_asset_%d[]={%s};'%(i,','.join(map(str,zipped))))
     meta.append({'path':path,'raw_bytes':len(data),'gzip_bytes':len(zipped),'sha256':hashlib.sha256(data).hexdigest()})
-assert sum(x['gzip_bytes'] for x in meta)<20000,'UI asset budget exceeded'
+assert sum(x['gzip_bytes'] for x in meta)<20200,'UI asset budget exceeded'
 lines.append('static const mttl_asset mttl_assets[]={'+','.join('{"%s","%s",mttl_asset_%d,sizeof(mttl_asset_%d)}'%(p,k,i,i) for i,(p,k,d) in enumerate(sources))+'};')
 (OUT/'ui_assets.h').write_text('\n'.join(lines)+'\n',encoding='utf-8')
 (OUT/'ui_assets.json').write_text(json.dumps(meta,indent=2),encoding='utf-8')
